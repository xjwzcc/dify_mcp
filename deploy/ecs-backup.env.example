# Install as /etc/shixunlab/backup.env, root:root, mode 0600.
# Separate from app.env: the web application must not receive backup credentials.
NODE_ENV=production
DATA_DIR=/var/lib/shixunlab
OSS_BACKUP_WORK_DIR=/var/backups/shixunlab
OSS_BUCKET=forcc-hangzhou
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_BACKUP_PREFIX=teaching/v1/ecs-backups
OSS_ECS_ROLE=ShixunlabEcsBackupRole
# Reuse the persistent storage key from the migration; never regenerate per deploy.
OSS_STORAGE_KEY=
