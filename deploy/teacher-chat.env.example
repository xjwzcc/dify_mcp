# Add to the existing FC environment; preserve storage and classroom credentials.
# Paused until teachers need AI execution. Re-enable both explicitly after capacity checks.
TEACHER_AGENT_MODE=disabled
ENABLE_TEACHER_CHAT=0
ENABLE_MCP=0
TEACHER_AGENT_MODEL=deepseek-flash
TEACHER_AGENT_REASONING_EFFORT=low
# Small ECS profile: one execution and one retained sandbox, 256 MiB sandbox RSS cap.
# Requires a 2 GiB cgroup and the shixunlab.service 1200 MiB MemoryMax; see TEACHER-CHAT.md.
# Keep FC min instances=0, max=1; disable delayed release.
# Close a session to release its retained slot; otherwise another session waits for reclamation (<=8h).
TEACHER_AGENT_MAX_ACTIVE=1
TEACHER_AGENT_MAX_PER_TEACHER=1
TEACHER_AGENT_MAX_RETAINED=1
DEEPSEEK_API_KEY=
# Internal signing keys and loopback addresses are generated at startup.
# Optional: empty means every currently authenticated teacher.
CHAT_TEACHER_ALLOWLIST=
# Required existing storage setting; FC maximum instance count must also be 1.
OSS_SINGLE_WRITER=1
