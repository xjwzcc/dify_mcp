# Add to the existing FC environment; preserve storage and classroom credentials.
TEACHER_AGENT_MODE=fc-internal
ENABLE_TEACHER_CHAT=1
TEACHER_AGENT_MODEL=deepseek-flash
TEACHER_AGENT_REASONING_EFFORT=low
# Four simultaneous executions require at least 3 GiB by startup checks; deploy with 4 GiB.
TEACHER_AGENT_MAX_ACTIVE=4
TEACHER_AGENT_MAX_PER_TEACHER=2
DEEPSEEK_API_KEY=
# Internal signing keys and loopback addresses are generated at startup.
# Optional: empty means every currently authenticated teacher.
CHAT_TEACHER_ALLOWLIST=
# Required existing storage setting; FC maximum instance count must also be 1.
OSS_SINGLE_WRITER=1
