# FC and forcc-hangzhou are both in Hangzhou; use the internal endpoint in FC.
# Local initialization/migration must override OSS_ENDPOINT with https://oss-cn-hangzhou.aliyuncs.com.
STORAGE_BACKEND=oss
OSS_BUCKET=forcc-hangzhou
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_PREFIX=teaching/v1
OSS_SINGLE_WRITER=1
# Generate once: openssl rand -hex 32. Retain securely across deployments.
OSS_STORAGE_KEY=
TEACHER_PASSWORD=
CATERING_CLASS_CODE=
HOTEL_CLASS_CODE=
# FC: use execution-role credentials. Local migration: supply scoped credentials securely.
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIBABA_CLOUD_SECURITY_TOKEN=
# Optional externally refreshed STS JSON file; re-read on every request:
# OSS_CREDENTIALS_FILE=
