# Copy to a secret .env.teaching on the resident host. Never commit real values.
TEACHING_MODE=1
TEACHING_ENV=production
TEACHING_BASE_URL=https://your-teaching-fc.example.com
TEACHING_DEPLOYMENT_ID=wushanyuan-production
# Match teaching FC AGENT_SIGNING_KEY / AGENT_TOOL_VERIFY_KEY respectively.
TEACHING_VERIFY_KEY=
TEACHING_TOOL_SIGNING_KEY=
DATABASE_URL=mysql+pymysql://agent_user:password@your-db/teacher_agent?charset=utf8mb4
BLOB_BACKEND=oss
AGENT_OSS_BUCKET=
AGENT_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
AGENT_OSS_REGION=cn-hangzhou
AGENT_OSS_PREFIX=teacher-agent/v1/
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Optional STS token. For automatic rotation mount a JSON credentials file instead:
# AGENT_OSS_CREDENTIALS_FILE=/run/secrets/oss.json
# JSON keys: access_key_id, access_key_secret, security_token
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
MODEL=deepseek-flash
BRIDGE_SIGNING_KEY=
CONTROL_ADMIN_KEY=
GATEWAY_URL=https://your-agent-control.example.com
SANDBOX_PROVIDER=fc
FC_TEMPLATE=
E2B_API_KEY=
E2B_API_URL=https://api.cn-hangzhou.e2b.fc.aliyuncs.com
E2B_DOMAIN=cn-hangzhou.e2b.fc.aliyuncs.com
FC_EGRESS_CIDRS=[]
FC_NETWORK_VERIFIED=false
CODEX_SANDBOX_MODE=workspace-write
ALLOW_EXTERNAL_SANDBOX=false
MAX_ACTIVE_EXECUTIONS=4
MAX_TEACHER_PENDING=3
ATTEMPT_SECONDS=300
LEASE_SECONDS=60
