# Generate values using: python3 scripts/configure.py
CHAT_API_KEYS={}
BRIDGE_SIGNING_KEY=
CONTROL_ADMIN_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash
SANDBOX_PROVIDER=docker
RUNNER_IMAGE=agent-demo-runner:0.1.0
GATEWAY_URL=http://control:8080

# workspace-write retains Codex's inner sandbox. It requires compatible kernel support.
CODEX_SANDBOX_MODE=workspace-write
ALLOW_EXTERNAL_SANDBOX=false

# For an explicitly accepted outer-only Docker/FC sandbox profile:
# CODEX_SANDBOX_MODE=danger-full-access
# ALLOW_EXTERNAL_SANDBOX=true
# This never enables a host-process backend.

# FC control plane must use a shared SQL DB and object storage.
# DATABASE_URL=mysql+pymysql://user:password@db/agent?charset=utf8mb4
# BLOB_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=cn-hangzhou
# FC_TEMPLATE=
# E2B_API_KEY=
# E2B_API_URL=https://api.cn-hangzhou.e2b.fc.aliyuncs.com
# E2B_DOMAIN=cn-hangzhou.e2b.fc.aliyuncs.com
# FC_EGRESS_CIDRS=["10.0.0.10/32"]
# FC_NETWORK_VERIFIED=true
